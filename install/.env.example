# Copy to .env and fill in. Lines marked "required" must be set. Docker Compose
# reads a $ in a value as the start of a variable: put any value with a $ in
# single quotes, e.g. ADMIN_PASSWORD='Blue$ky-2026' is read exactly as written.

# --- Addresses ---------------------------------------------------------------
# The console (sign-in, the atlas wizard and settings). Required.
CONSOLE_DOMAIN=data.example.org
# Atlases live at <atlas>.ATLAS_DOMAIN. Required; point *.ATLAS_DOMAIN at this server.
ATLAS_DOMAIN=atlas.example.org
# For Let's Encrypt's notices about your certificates. Required.
ACME_EMAIL=you@example.org

# --- First administrator (required) ------------------------------------------
# Created on first start. The password needs upper- and lower-case letters, a
# number and a symbol (single quotes if it has a $, see the top).
ADMIN_EMAIL=you@example.org
ADMIN_PASSWORD=

# --- Secrets (required; make each one long and random) -------------------------
# e.g. `openssl rand -hex 64`
SECRET_KEY_BASE=
# Letters and digits only (it goes into a connection URL), e.g. `openssl rand -hex 24`
POSTGRES_PASSWORD=

# --- Recommended -------------------------------------------------------------
# MapTiler key: maps in the console (https://cloud.maptiler.com, free tier). It's
# built into the FairData console: after changing it, `docker compose up -d --build`.
VITE_MAP_TILER_KEY=
# GeoNames username: areas and place lookups (https://www.geonames.org/login, free).
GEONAMES_USERNAME=
# A contact sent with OpenStreetMap address lookups, as its usage policy asks.
OG_NOMINATIM_EMAIL=

# --- Optional ----------------------------------------------------------------
# Email (invitations to curators, feedback): a Postmark server token and sender.
POSTMARK_API_TOKEN=
POSTMARK_FROM=
# IIIF Cloud for atlas photos (otherwise photos are shown from their source).
IIIF_CLOUD_URL=
IIIF_CLOUD_API_KEY=
IIIF_CLOUD_PROJECT_ID=
# A vector tile server atlases can load through their own address.
OG_TILE_SERVER=
# Uploaded files are kept on this server (the `storage` volume). To keep them in
# S3 or an S3-compatible store instead, name the bucket and give its keys; the
# endpoint is blank for AWS, and other stores often need path-style addresses.
#S3_BUCKET=
#S3_ACCESS_KEY=
#S3_SECRET_KEY=
#S3_REGION=us-east-1
#S3_ENDPOINT=
#S3_FORCE_PATH_STYLE=true
# Elasticsearch memory (2 GB+ server: 1g; larger atlases want more).
#ES_HEAP=1g

# --- Versions ----------------------------------------------------------------
# The FairData host branch that mounts the engine (until it's merged into `ecds`).
#HOST_REF=og/platform-engine
# A newer engine commit than the host pins (a commit, not a branch name: the
# build caches by this value).
#ENGINE_REF=
# The renderer (ecds/core-data-places) branch or commit.
#RENDERER_REF=main

# --- Trying it on one computer (no DNS, no certificates) ---------------------
#CONSOLE_DOMAIN=console.localhost
#ATLAS_DOMAIN=atlas.localhost
#PUBLIC_SCHEME=http
#HTTP_PORT=8080
#HTTPS_PORT=8443
#PUBLIC_PORT=:8080
#CADDYFILE=Caddyfile.local
