# Copy to .env. Only the two keys are required; everything else has a demo default.

# MapTiler key: the wizard's area picker and the FairData console's maps.
VITE_MAP_TILER_KEY=
# GeoNames account name: the wizard's administrative-unit picker and place imports.
GEONAMES_USERNAME=

# Console / engine sign-in created on first run.
#DEMO_ADMIN_EMAIL=admin@example.com
#DEMO_ADMIN_PASSWORD=Changeme1!!

# Skip the FairData console build (faster image; engine pages still work).
#BUILD_CONSOLE=0
# Seed only the account, not HRCGA.
#DEMO_SKIP_HRCGA=1
# Renderer git ref (ecds/core-data-places).
#RENDERER_REF=main
# Host port for the renderer (if 4321 is taken).
#RENDERER_PORT=4321
