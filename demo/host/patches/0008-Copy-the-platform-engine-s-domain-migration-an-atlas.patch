From 4270ee75f0f7df1161bfbda3de354152cd0ed2ac Mon Sep 17 00:00:00 2001
From: terminusfilms <steve@terminusfilms.com>
Date: Fri, 2 Oct 2026 08:59:01 -0400
Subject: [PATCH] Copy the platform engine's domain migration (an atlas's own
 domain)

---
 ...a_connector_sites.open_geographies_platform.rb | 15 +++++++++++++++
 1 file changed, 15 insertions(+)
 create mode 100644 db/migrate/20261002124352_add_domain_to_core_data_connector_sites.open_geographies_platform.rb

diff --git a/db/migrate/20261002124352_add_domain_to_core_data_connector_sites.open_geographies_platform.rb b/db/migrate/20261002124352_add_domain_to_core_data_connector_sites.open_geographies_platform.rb
new file mode 100644
index 0000000..dc2d618
--- /dev/null
+++ b/db/migrate/20261002124352_add_domain_to_core_data_connector_sites.open_geographies_platform.rb
@@ -0,0 +1,15 @@
+# This migration comes from open_geographies_platform (originally 20261002150000)
+# An atlas can have a domain of its own (atlas.example.org) besides its
+# address on the platform (<slug>.<base domain>). The domain is connected
+# only once its DNS names this atlas (see CoreDataConnector::SiteDomains);
+# until then it's stored but not served. More than one atlas may have
+# entered the same domain, but only one can be connected to it.
+class AddDomainToCoreDataConnectorSites < ActiveRecord::Migration[8.1]
+  def change
+    add_column :core_data_connector_sites, :domain, :string
+    add_column :core_data_connector_sites, :domain_verified_at, :datetime
+
+    add_index :core_data_connector_sites, :domain, unique: true, where: 'domain_verified_at IS NOT NULL',
+                                                   name: 'index_core_data_connector_sites_on_connected_domain'
+  end
+end
-- 
